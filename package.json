{
  "name": "interface-router",
  "productName": "Interface Router",
  "version": "1.0.0",
  "description": "Назначение приложений и доменов на конкретный сетевой интерфейс компьютера",
  "main": "src/main/index.js",
  "author": "InterfaceRouter",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c blue,magenta \"vite\" \"wait-on tcp:5173 && electron . --dev\"",
    "build": "vite build",
    "start": "npm run build && electron .",
    "smoke": "vite build && set SMOKE_TEST=1&& electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:all": "npm run build && electron-builder -mwl"
  },
  "build": {
    "appId": "dev.interfacerouter.app",
    "productName": "Interface Router",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/preload/**/*",
      "src/shared/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "requestedExecutionLevel": "highestAvailable"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Interface Router",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "category": "public.app-category.utilities",
      "darkModeSupport": true
    },
    "linux": {
      "target": ["AppImage", "deb", "rpm"],
      "category": "Network",
      "maintainer": "Interface Router <penisxuei@email.com>",
      "synopsis": "Назначение приложений и доменов на сетевой интерфейс",
      "description": "Interface Router — назначение приложений и доменов на конкретный сетевой интерфейс компьютера."
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  }
}
